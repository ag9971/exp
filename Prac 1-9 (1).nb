Cell[BoxData[
 RowBox[{
  RowBox[{"transitiveQ", "[", 
   RowBox[{"R_", "?", "relationQ"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c", ",", "domain"}], "}"}], ",", 
