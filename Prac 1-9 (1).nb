  RowBox[{"coversQ", "[", 
   RowBox[{
    RowBox[{"R_", "?", "partialorderQ"}], ",", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"z", ",", "checkset"}], "}"}], ",", 
    RowBox[{
     RowBox[{"checkset", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"findDomain", "[", "R", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"Catch", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"x", "\[Equal]", "y"}], ",", 
